#!/usr/bin/env bash
# =====================================================================
#  INTERBANK TRANSFER TRANSACTION — Professional Launcher
#  Version: 3.0 | Build: 2026.05
# =====================================================================
#
#  Usage:
#    ./interbank          — start the terminal
#    ./interbank --help   — show help
#    ./interbank --version — show version
#
# =====================================================================

set -e

VERSION="3.0.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"
ENGINE="${SCRIPT_DIR}/interbank_terminal.py"

case "${1:-}" in
    -h|--help)
        cat <<EOF
INTERBANK TRANSFER TRANSACTION — v${VERSION}

Usage:
  interbank             Launch the transfer terminal
  interbank --help      Show this help message
  interbank --version   Show version

Default credentials (simulation):
  Username : admin
  Password : admin

EOF
        exit 0
        ;;
    -v|--version)
        echo "INTERBANK TRANSFER TRANSACTION v${VERSION}"
        exit 0
        ;;
esac

# Verify Python is available
if ! command -v "${PYTHON_BIN}" >/dev/null 2>&1; then
    echo "Error: ${PYTHON_BIN} is not installed or not in PATH" >&2
    exit 1
fi

# Verify engine exists
if [ ! -f "${ENGINE}" ]; then
    echo "Error: engine file not found at ${ENGINE}" >&2
    exit 1
fi

# Launch
exec "${PYTHON_BIN}" "${ENGINE}" "$@"
